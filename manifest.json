{
  "manifest_version": 3,
  "name": "Cerca indirizzo su Google Maps",
  "description": "Cerca indirizzi selezionati su Google Maps e aggiunge un pulsante GMaps a Google e Bing.",
  "version": "0.1.0",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/search*"
      ],
      "js": [
        "content/maps-button.js"
      ],
      "css": [
        "content/maps-button.css"
      ],
      "run_at": "document_idle",
      "include_globs": [
        "https://www.google.*/search*",
        "https://www.bing.com/search*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Impostazioni Maps",
    "default_popup": "options/options.html"
  }
}
